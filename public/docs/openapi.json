{
  "openapi": "3.0.0",
  "info": {
    "title": "Heirs OCR Service",
    "version": "1.0.0",
    "description": "Comprehensive API documentation for Heirs OCR Service. This API provides a single endpoint for OCR processing with multiple function types, each with its own payload schema. Supported functions: TEXT_EXTRACTION, DOCUMENT_CLASSIFICATION, SIGNING, ID_VERIFICATION, FORM_DATA_EXTRACTION, RECEIPT_PARSING.",
    "contact": {
      "name": "Heirs Technologies",
      "email": "support@heirstechnologies.com"
    },
    "license": {
      "name": "MIT"
    }
  },
  "servers": [
    {
      "url": "http://localhost:8080",
      "description": "Development Server"
    },
    {
      "url": "",
      "description": "Production Server"
    }
  ],
  "tags": [
    {
      "name": "OCR",
      "description": "Document OCR processing operations"
    }
  ],
  "paths": {
    "/api/ocr": {
      "post": {
        "tags": ["OCR"],
        "summary": "Process a document with OCR",
        "description": "Upload a document file and specify which OCR function to run. Send `function`, `fields`, and optionally `comparisonData` as separate form fields.",
        "operationId": "processOcr",
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "required": ["file", "function", "fields"],
                "properties": {
                  "file": {
                    "type": "string",
                    "format": "binary",
                    "description": "The document file to process. Max size: 10 MB. Allowed types: application/pdf, image/png, image/jpeg, image/tiff, image/webp."
                  },
                  "function": {
                    "type": "string",
                    "enum": [
                      "TEXT_EXTRACTION",
                      "SIGNING",
                      "ID_VERIFICATION",
                      "DOCUMENT_CLASSIFICATION",
                      "FORM_DATA_EXTRACTION",
                      "RECEIPT_PARSING"
                    ],
                    "description": "The OCR function to execute."
                  },
                  "fields": {
                    "type": "string",
                    "description": "JSON string with function-specific fields.\n\n**Per function:**\n- `TEXT_EXTRACTION`: `{\"language\": \"eng\"}` (optional, defaults to eng)\n- `SIGNING`: `{\"signerName\": \"John Doe\", \"expectedDate\": \"15/01/2026\"}` (signerName required)\n- `ID_VERIFICATION`: `{\"documentType\": \"passport\"}` (required, one of: national_id, passport, drivers_license)\n- `DOCUMENT_CLASSIFICATION`: `{\"expectedType\": \"code_of_conduct\"}` (optional)\n- `FORM_DATA_EXTRACTION`: `{\"targetFields\": [\"Name\", \"Email\"]}` (optional)\n- `RECEIPT_PARSING`: `{\"currency\": \"NGN\", \"expectedTaxRate\": 0.075, \"lineItemMode\": \"multiple\", \"fieldMap\": {\"merchant.name\": \"vendor\", \"total\": \"amount_due\"}}` (all optional; `fieldMap` selects and renames the returned fields)",
                    "example": "{\"language\": \"eng\"}"
                  },
                  "comparisonData": {
                    "type": "string",
                    "description": "Optional JSON string with data to compare against extracted results. Only applicable to SIGNING and ID_VERIFICATION.\n\n**SIGNING**: `{\"name\": \"John Doe\", \"date\": \"15/01/2026\"}` (name required)\n\n**ID_VERIFICATION**: `{\"fullName\": \"Jane Smith\", \"dateOfBirth\": \"15/03/1990\", \"idNumber\": \"A12345678\"}` (fullName required)"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OCR processing completed successfully. The `data.result` schema varies by function.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "example": true
                    },
                    "message": {
                      "type": "string",
                      "example": "SIGNING completed successfully."
                    },
                    "data": {
                      "oneOf": [
                        {
                          "$ref": "#/components/schemas/SigningResponseData"
                        },
                        {
                          "$ref": "#/components/schemas/IdVerificationResponseData"
                        },
                        {
                          "$ref": "#/components/schemas/DocumentClassificationResponseData"
                        },
                        {
                          "$ref": "#/components/schemas/FormDataExtractionResponseData"
                        },
                        {
                          "$ref": "#/components/schemas/ReceiptParsingResponseData"
                        },
                        {
                          "$ref": "#/components/schemas/TextExtractionResponseData"
                        }
                      ],
                      "discriminator": {
                        "propertyName": "function"
                      }
                    }
                  }
                },
                "examples": {
                  "TEXT_EXTRACTION": {
                    "summary": "Text extraction response",
                    "value": {
                      "success": true,
                      "message": "TEXT_EXTRACTION completed successfully.",
                      "data": {
                        "function": "TEXT_EXTRACTION",
                        "result": {
                          "text": "This is the extracted text content from the document...",
                          "pages": 2,
                          "extractionMethod": "text"
                        }
                      }
                    }
                  },
                  "SIGNING": {
                    "summary": "Signing verification response",
                    "value": {
                      "success": true,
                      "message": "SIGNING completed successfully.",
                      "data": {
                        "function": "SIGNING",
                        "result": {
                          "signatureDetected": true,
                          "signatureConfidence": 0.85,
                          "signerNameFound": true,
                          "dateFound": true,
                          "extractedSignerName": "John Doe",
                          "extractedDate": "15/01/2026",
                          "comparisonResult": {
                            "nameMatch": true,
                            "dateMatch": true,
                            "overallMatch": true
                          }
                        }
                      }
                    }
                  },
                  "ID_VERIFICATION": {
                    "summary": "ID verification response",
                    "value": {
                      "success": true,
                      "message": "ID_VERIFICATION completed successfully.",
                      "data": {
                        "function": "ID_VERIFICATION",
                        "result": {
                          "extractedName": "Jane Smith",
                          "extractedDateOfBirth": "15/03/1990",
                          "extractedIdNumber": "A12345678",
                          "extractedDocumentType": "passport",
                          "rawText": "PASSPORT ... Name: Jane Smith ...",
                          "comparisonResult": {
                            "nameMatch": true,
                            "dobMatch": true,
                            "idNumberMatch": true,
                            "overallMatch": true
                          }
                        }
                      }
                    }
                  },
                  "DOCUMENT_CLASSIFICATION": {
                    "summary": "Document classification response",
                    "value": {
                      "success": true,
                      "message": "DOCUMENT_CLASSIFICATION completed successfully.",
                      "data": {
                        "function": "DOCUMENT_CLASSIFICATION",
                        "result": {
                          "detectedType": "code_of_conduct",
                          "confidence": 0.71,
                          "matchedKeywords": [
                            "code of conduct",
                            "professional standards",
                            "academic integrity",
                            "misconduct",
                            "ethical"
                          ],
                          "pages": 3,
                          "extractionMethod": "text"
                        }
                      }
                    }
                  },
                  "FORM_DATA_EXTRACTION": {
                    "summary": "Form data extraction response",
                    "value": {
                      "success": true,
                      "message": "FORM_DATA_EXTRACTION completed successfully.",
                      "data": {
                        "function": "FORM_DATA_EXTRACTION",
                        "result": {
                          "fields": {
                            "Name": "John Doe",
                            "Email": "john@example.com",
                            "Phone": "+234 800 000 0000"
                          },
                          "rawText": "Name: John Doe\nEmail: john@example.com\nPhone: +234 800 000 0000",
                          "pages": 1,
                          "extractionMethod": "text"
                        }
                      }
                    }
                  },
                  "RECEIPT_PARSING": {
                    "summary": "Receipt parsing response",
                    "value": {
                      "requestId": "req_01J7X9K2M4",
                      "function": "RECEIPT_PARSING",
                      "result": {
                        "merchant": {
                          "name": "Shoprite",
                          "address": "12 Awolowo Rd, Lagos",
                          "tin": "01234567-0001"
                        },
                        "dateTime": "2026-02-14T18:32:00+01:00",
                        "currency": "NGN",
                        "lineItems": [
                          {
                            "description": "Milk 1L",
                            "qty": 2,
                            "unitPrice": 1500,
                            "total": 3000
                          }
                        ],
                        "subtotal": 3000,
                        "tax": 225,
                        "tip": null,
                        "total": 3225,
                        "paymentMethod": "card",
                        "confidence": "high",
                        "warnings": []
                      },
                      "meta": {
                        "provider": "glm-ocr",
                        "fellBackFrom": null,
                        "pageCount": 1,
                        "cached": false,
                        "confidence": 1,
                        "durationMs": 4120,
                        "tokensUsed": 1830
                      }
                    }
                  },
                  "RECEIPT_PARSING_fieldMap": {
                    "summary": "Receipt parsing with a caller fieldMap",
                    "description": "args = {\"fieldMap\":{\"merchant.name\":\"vendor\",\"total\":\"amount_due\",\"lineItems.description\":\"item\",\"lineItems.total\":\"line_total\"}}",
                    "value": {
                      "requestId": "req_01J7X9K2M5",
                      "function": "RECEIPT_PARSING",
                      "result": {
                        "vendor": "Shoprite",
                        "amount_due": 3225,
                        "lineItems": [
                          {
                            "item": "Milk 1L",
                            "line_total": 3000
                          }
                        ],
                        "confidence": "high",
                        "warnings": []
                      }
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Bad request. File missing, payload missing, invalid JSON, or invalid function name.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "examples": {
                  "missingFile": {
                    "summary": "No file uploaded",
                    "value": {
                      "success": false,
                      "message": "File is required. Send a file in the 'file' form field.",
                      "data": null
                    }
                  },
                  "missingFields": {
                    "summary": "Missing required form fields",
                    "value": {
                      "success": false,
                      "message": "'function' and 'fields' are required in the form body.",
                      "data": null
                    }
                  },
                  "invalidFieldsJson": {
                    "summary": "Malformed JSON in fields",
                    "value": {
                      "success": false,
                      "message": "'fields' must be a valid JSON string.",
                      "data": null
                    }
                  },
                  "invalidFunction": {
                    "summary": "Unknown function name",
                    "value": {
                      "success": false,
                      "message": "Invalid function 'UNKNOWN'. Must be one of: SIGNING, ID_VERIFICATION, DOCUMENT_CLASSIFICATION, FORM_DATA_EXTRACTION, RECEIPT_PARSING, TEXT_EXTRACTION",
                      "data": null
                    }
                  }
                }
              }
            }
          },
          "422": {
            "description": "Validation failed. The payload fields did not pass function-specific validation.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "example": false
                    },
                    "message": {
                      "type": "string",
                      "example": "Validation failed."
                    },
                    "data": {
                      "type": "object",
                      "properties": {
                        "errors": {
                          "type": "array",
                          "items": {
                            "type": "string"
                          }
                        }
                      }
                    }
                  }
                },
                "examples": {
                  "signingValidation": {
                    "summary": "Missing signer name for SIGNING",
                    "value": {
                      "success": false,
                      "message": "Validation failed.",
                      "data": {
                        "errors": ["fields.signerName is required and must be a string"]
                      }
                    }
                  },
                  "idVerificationValidation": {
                    "summary": "Invalid document type for ID_VERIFICATION",
                    "value": {
                      "success": false,
                      "message": "Validation failed.",
                      "data": {
                        "errors": ["fields.documentType must be one of: national_id, passport, drivers_license"]
                      }
                    }
                  }
                }
              }
            }
          },
          "404": {
            "description": "Route not found.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "success": false,
                  "message": "Route not found.",
                  "data": null
                }
              }
            }
          },
          "500": {
            "description": "Internal server error during OCR processing.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "success": false,
                  "message": "Internal Server Error.",
                  "data": null
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ErrorResponse": {
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean",
            "example": false
          },
          "message": {
            "type": "string"
          },
          "data": {
            "nullable": true
          }
        }
      },
      "SigningPayload": {
        "type": "object",
        "required": ["function", "fields"],
        "properties": {
          "function": {
            "type": "string",
            "enum": ["SIGNING"]
          },
          "fields": {
            "$ref": "#/components/schemas/SigningFields"
          },
          "comparisonData": {
            "$ref": "#/components/schemas/SigningComparisonData"
          }
        }
      },
      "SigningFields": {
        "type": "object",
        "required": ["signerName"],
        "properties": {
          "signerName": {
            "type": "string",
            "description": "The name of the expected signer to search for in the document.",
            "example": "John Doe"
          },
          "expectedDate": {
            "type": "string",
            "description": "The expected signing date.",
            "example": "15/01/2026"
          }
        }
      },
      "SigningComparisonData": {
        "type": "object",
        "required": ["name"],
        "properties": {
          "name": {
            "type": "string",
            "description": "Name to compare against the document content.",
            "example": "John Doe"
          },
          "date": {
            "type": "string",
            "description": "Date to compare against extracted dates.",
            "example": "15/01/2026"
          }
        }
      },
      "SigningResult": {
        "type": "object",
        "properties": {
          "signatureDetected": {
            "type": "boolean",
            "description": "Whether a signature was detected in the document."
          },
          "signatureConfidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1,
            "description": "Confidence score for signature detection (0-1)."
          },
          "signerNameFound": {
            "type": "boolean",
            "description": "Whether the specified signer name was found in the document text."
          },
          "dateFound": {
            "type": "boolean",
            "description": "Whether a date pattern was found in the document."
          },
          "extractedSignerName": {
            "type": "string",
            "nullable": true,
            "description": "The signer name if found, null otherwise."
          },
          "extractedDate": {
            "type": "string",
            "nullable": true,
            "description": "The first date pattern found in the document, null if none."
          },
          "comparisonResult": {
            "type": "object",
            "description": "Present only when comparisonData was provided in the request.",
            "properties": {
              "nameMatch": {
                "type": "boolean"
              },
              "dateMatch": {
                "type": "boolean"
              },
              "overallMatch": {
                "type": "boolean",
                "description": "True only if name matches, date matches, and signature is detected."
              }
            }
          }
        }
      },
      "SigningResponseData": {
        "type": "object",
        "properties": {
          "function": {
            "type": "string",
            "enum": ["SIGNING"]
          },
          "result": {
            "$ref": "#/components/schemas/SigningResult"
          }
        }
      },
      "IdVerificationPayload": {
        "type": "object",
        "required": ["function", "fields"],
        "properties": {
          "function": {
            "type": "string",
            "enum": ["ID_VERIFICATION"]
          },
          "fields": {
            "$ref": "#/components/schemas/IdVerificationFields"
          },
          "comparisonData": {
            "$ref": "#/components/schemas/IdVerificationComparisonData"
          }
        }
      },
      "IdVerificationFields": {
        "type": "object",
        "required": ["documentType"],
        "properties": {
          "documentType": {
            "type": "string",
            "enum": ["national_id", "passport", "drivers_license"],
            "description": "The type of ID document being verified."
          }
        }
      },
      "IdVerificationComparisonData": {
        "type": "object",
        "required": ["fullName"],
        "properties": {
          "fullName": {
            "type": "string",
            "description": "Full name to compare against the extracted name.",
            "example": "Jane Smith"
          },
          "dateOfBirth": {
            "type": "string",
            "description": "Date of birth to compare. Flexible format matching.",
            "example": "15/03/1990"
          },
          "idNumber": {
            "type": "string",
            "description": "ID number to compare (exact match).",
            "example": "A12345678"
          }
        }
      },
      "IdVerificationResult": {
        "type": "object",
        "properties": {
          "extractedName": {
            "type": "string",
            "nullable": true,
            "description": "Name extracted from the ID document."
          },
          "extractedDateOfBirth": {
            "type": "string",
            "nullable": true,
            "description": "Date of birth extracted from the ID document."
          },
          "extractedIdNumber": {
            "type": "string",
            "nullable": true,
            "description": "ID number extracted from the document."
          },
          "extractedDocumentType": {
            "type": "string",
            "nullable": true,
            "description": "The document type as specified in the request."
          },
          "rawText": {
            "type": "string",
            "description": "The full raw text extracted from the document."
          },
          "comparisonResult": {
            "type": "object",
            "description": "Present only when comparisonData was provided.",
            "properties": {
              "nameMatch": {
                "type": "boolean"
              },
              "dobMatch": {
                "type": "boolean"
              },
              "idNumberMatch": {
                "type": "boolean"
              },
              "overallMatch": {
                "type": "boolean",
                "description": "True only if all provided comparison fields match."
              }
            }
          }
        }
      },
      "IdVerificationResponseData": {
        "type": "object",
        "properties": {
          "function": {
            "type": "string",
            "enum": ["ID_VERIFICATION"]
          },
          "result": {
            "$ref": "#/components/schemas/IdVerificationResult"
          }
        }
      },
      "DocumentClassificationPayload": {
        "type": "object",
        "required": ["function", "fields"],
        "properties": {
          "function": {
            "type": "string",
            "enum": ["DOCUMENT_CLASSIFICATION"]
          },
          "fields": {
            "$ref": "#/components/schemas/DocumentClassificationFields"
          }
        }
      },
      "DocumentClassificationFields": {
        "type": "object",
        "properties": {
          "expectedType": {
            "type": "string",
            "description": "Optional hint for the expected document type. Supported types: letter_of_recommendation, code_of_conduct, photo_media_consent, disclaimer_indemnity.",
            "example": "code_of_conduct"
          }
        }
      },
      "DocumentClassificationResult": {
        "type": "object",
        "properties": {
          "detectedType": {
            "type": "string",
            "nullable": true,
            "description": "The detected document type, or null if confidence is too low. Possible values: letter_of_recommendation, code_of_conduct, photo_media_consent, disclaimer_indemnity.",
            "example": "code_of_conduct"
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1,
            "description": "Classification confidence score (0-1)."
          },
          "matchedKeywords": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "The keywords from the document that matched the detected type."
          },
          "pages": {
            "type": "integer",
            "description": "Number of pages in the document."
          },
          "extractionMethod": {
            "type": "string",
            "enum": ["text", "ocr"],
            "description": "Whether text was extracted directly or via OCR."
          }
        }
      },
      "DocumentClassificationResponseData": {
        "type": "object",
        "properties": {
          "function": {
            "type": "string",
            "enum": ["DOCUMENT_CLASSIFICATION"]
          },
          "result": {
            "$ref": "#/components/schemas/DocumentClassificationResult"
          }
        }
      },
      "FormDataExtractionPayload": {
        "type": "object",
        "required": ["function", "fields"],
        "properties": {
          "function": {
            "type": "string",
            "enum": ["FORM_DATA_EXTRACTION"]
          },
          "fields": {
            "$ref": "#/components/schemas/FormDataExtractionFields"
          }
        }
      },
      "FormDataExtractionFields": {
        "type": "object",
        "properties": {
          "targetFields": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Optional list of specific field names to extract. If omitted, all detected key-value pairs are returned.",
            "example": ["Name", "Email", "Phone"]
          }
        }
      },
      "FormDataExtractionResult": {
        "type": "object",
        "properties": {
          "fields": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            },
            "description": "Extracted key-value pairs from the form.",
            "example": {
              "Name": "John Doe",
              "Email": "john@example.com"
            }
          },
          "rawText": {
            "type": "string",
            "description": "The full raw text extracted from the document."
          },
          "pages": {
            "type": "integer",
            "description": "Number of pages in the document."
          },
          "extractionMethod": {
            "type": "string",
            "enum": ["text", "ocr"]
          }
        }
      },
      "FormDataExtractionResponseData": {
        "type": "object",
        "properties": {
          "function": {
            "type": "string",
            "enum": ["FORM_DATA_EXTRACTION"]
          },
          "result": {
            "$ref": "#/components/schemas/FormDataExtractionResult"
          }
        }
      },
      "ReceiptParsingPayload": {
        "type": "object",
        "required": ["function", "fields"],
        "properties": {
          "function": {
            "type": "string",
            "enum": ["RECEIPT_PARSING"]
          },
          "fields": {
            "$ref": "#/components/schemas/ReceiptParsingFields"
          }
        }
      },
      "ReceiptParsingFields": {
        "type": "object",
        "properties": {
          "currency": {
            "type": "string",
            "default": "NGN",
            "description": "ISO 4217 currency code. Defaults to NGN.",
            "example": "NGN"
          },
          "expectedTaxRate": {
            "type": "number",
            "default": 0.075,
            "minimum": 0,
            "maximum": 1,
            "description": "Expected VAT rate as a fraction, used by the deterministic totals reconciliation. Nigeria: 0.075."
          },
          "lineItemMode": {
            "type": "string",
            "enum": ["multiple", "single"],
            "default": "multiple",
            "description": "How the upload is reported. 'multiple' returns the receipt itemized as printed; 'single' collapses it to one line carrying the subtotal. Reconciliation runs against the printed lines either way."
          },
          "fieldMap": {
            "type": "object",
            "additionalProperties": {
              "type": "string",
              "maxLength": 64,
              "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
            },
            "description": "Optional { canonical field path -> your field name } map. Keys select which fields come back, values rename them. Valid keys: merchant.name, merchant.address, merchant.tin, dateTime, currency, subtotal, tax, tip, total, paymentMethod, lineItems, lineItems.description, lineItems.qty, lineItems.unitPrice, lineItems.total, confidence, warnings. The reconciliation verdict (confidence, warnings) is always returned; map it to rename it. Omit for the canonical shape.",
            "example": {
              "merchant.name": "vendor",
              "total": "amount_due",
              "lineItems.description": "item"
            }
          }
        }
      },
      "ReceiptParsingResult": {
        "type": "object",
        "description": "The canonical receipt shape. When the request supplies a `fieldMap`, the keys are the caller's own instead; `confidence` and `warnings` are always present under their mapped (or default) names.",
        "properties": {
          "merchant": {
            "type": "object",
            "description": "Merchant details as printed.",
            "properties": {
              "name": {
                "type": "string",
                "nullable": true
              },
              "address": {
                "type": "string",
                "nullable": true
              },
              "tin": {
                "type": "string",
                "nullable": true
              }
            }
          },
          "dateTime": {
            "type": "string",
            "nullable": true,
            "description": "Date/time printed on the receipt."
          },
          "currency": {
            "type": "string",
            "nullable": true,
            "description": "Detected or specified currency code."
          },
          "lineItems": {
            "type": "array",
            "description": "One entry per printed line, or a single synthesized line when lineItemMode is 'single'.",
            "items": {
              "type": "object",
              "properties": {
                "description": {
                  "type": "string"
                },
                "qty": {
                  "type": "number",
                  "nullable": true
                },
                "unitPrice": {
                  "type": "number",
                  "nullable": true
                },
                "total": {
                  "type": "number",
                  "nullable": true
                }
              }
            }
          },
          "subtotal": {
            "type": "number",
            "nullable": true,
            "description": "Subtotal before tax and tip."
          },
          "tax": {
            "type": "number",
            "nullable": true,
            "description": "Tax/VAT amount if printed."
          },
          "tip": {
            "type": "number",
            "nullable": true,
            "description": "Tip amount if printed."
          },
          "total": {
            "type": "number",
            "nullable": true,
            "description": "Grand total as printed."
          },
          "paymentMethod": {
            "type": "string",
            "nullable": true,
            "description": "Payment method if printed."
          },
          "confidence": {
            "type": "string",
            "enum": ["high", "low"],
            "description": "Deterministic totals-reconciliation verdict, recomputed in code — never the model's own assessment. 'low' means the arithmetic did not reconcile."
          },
          "warnings": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Reconciliation warnings, e.g. line items not summing to the subtotal. Empty when everything reconciled."
          }
        },
        "required": ["merchant", "lineItems", "confidence", "warnings"]
      },
      "ReceiptParsingResponseData": {
        "type": "object",
        "properties": {
          "function": {
            "type": "string",
            "enum": ["RECEIPT_PARSING"]
          },
          "result": {
            "$ref": "#/components/schemas/ReceiptParsingResult"
          }
        }
      },
      "TextExtractionPayload": {
        "type": "object",
        "required": ["function", "fields"],
        "properties": {
          "function": {
            "type": "string",
            "enum": ["TEXT_EXTRACTION"]
          },
          "fields": {
            "$ref": "#/components/schemas/TextExtractionFields"
          }
        }
      },
      "TextExtractionFields": {
        "type": "object",
        "properties": {
          "language": {
            "type": "string",
            "description": "Tesseract language code for OCR fallback. Defaults to 'eng'.",
            "example": "eng",
            "default": "eng"
          }
        }
      },
      "TextExtractionResult": {
        "type": "object",
        "properties": {
          "text": {
            "type": "string",
            "description": "The extracted text content from the document."
          },
          "pages": {
            "type": "integer",
            "description": "Number of pages in the document."
          },
          "extractionMethod": {
            "type": "string",
            "enum": ["text", "ocr"],
            "description": "'text' if extracted directly from PDF, 'ocr' if Tesseract was used."
          }
        }
      },
      "TextExtractionResponseData": {
        "type": "object",
        "properties": {
          "function": {
            "type": "string",
            "enum": ["TEXT_EXTRACTION"]
          },
          "result": {
            "$ref": "#/components/schemas/TextExtractionResult"
          }
        }
      }
    }
  }
}
