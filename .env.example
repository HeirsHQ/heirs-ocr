# Copy to .env and fill in. Validated by src/config/env.ts at startup.
# Do NOT commit the real .env (it is gitignored).

# --- Server ---
PORT=8080
NODE_ENV=development

# --- Redis (cache + BullMQ queue + rate limiter + tenant/API-key registry) ---
REDIS_URL=redis://localhost:6379

# --- Auth (Redis-backed API keys; no database) ---
# AUTH_ENABLED=false bypasses auth entirely — LOCAL DEV ONLY, never in prod.
AUTH_ENABLED=true
API_KEY_CACHE_TTL_SECONDS=30

# --- Admin console (/admin) ---
# Operator UI for tenant management + observability. Admin users live in Redis.
# The first owner is seeded automatically on startup when the registry is empty
# (idempotent) — change the password after first login. Session lifetime:
ADMIN_SESSION_TTL_SECONDS=28800
ADMIN_BOOTSTRAP_EMAIL=samson.okunola@heirstechnologies.com
ADMIN_BOOTSTRAP_PASSWORD=Admin@1234#

# --- CORS (server-to-server: default closed) ---
# Comma-separated browser origins to allow. Empty = no cross-origin browser
# access (backends are unaffected). Never uses "*".
CORS_ALLOWED_ORIGINS=

# --- Rate limiting (per tenant, fixed window; fails open if Redis is down) ---
RATE_LIMIT_ENABLED=true
RATE_LIMIT_MAX=60
RATE_LIMIT_WINDOW_SECONDS=60

# --- Upload / async thresholds ---
MAX_FILE_SIZE_BYTES=52428800
ASYNC_PAGE_THRESHOLD=5
ASYNC_SIZE_THRESHOLD_BYTES=5242880
EXTRACTION_CACHE_TTL_SECONDS=604800

# --- Azure OpenAI (interpretation layer) ---
AZURE_OPENAI_ENABLED=false
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_VERSION=
AZURE_OPENAI_DEPLOYMENT_NAME=

# --- GLM-OCR (layout-aware extraction) ---
GLM_ENABLED=false
GLM_API_KEY=
GLM_BASE_URL=https://api.z.ai/api/paas/v4
GLM_MAX_PAGES=30
GLM_CONCURRENCY=8

VERSION=1.0.0
